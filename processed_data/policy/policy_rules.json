        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/2/subtext/1",
          "source_text": "Silver members: > Ask for the purchase date, return possible within the last 6 months <or> Ask if they have a receipt, get to return if user has receipt <or> Ask if in original packaging, get to return if in original packaging"
        }
      ]
    },
