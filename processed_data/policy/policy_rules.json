          {
            "any": [
              {
                "purchase_within": "last_6_months"
              },
              {
                "has_receipt": true
              },
              {
                "original_packaging": true
              }
            ]
          }
        ]
      },
      "decision": "return_allowed",
      "origin": "abcd_guidelines",
