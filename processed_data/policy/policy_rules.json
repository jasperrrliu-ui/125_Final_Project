          "source_path": "Purchase Dispute/subflows/Promo Code Invalid/actions/4/subtext/0",
          "source_text": "No need to enter anything into the form."
        },
        {
          "source_path": "Purchase Dispute/subflows/Promo Code Invalid/actions/4/subtext/1",
          "source_text": "Click on [Promo Code]"
        }
      ]
