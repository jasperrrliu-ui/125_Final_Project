      "evidence": [
        {
          "source_path": "Purchase Dispute/subflows/Promo Code Invalid/actions/1/text",
          "source_text": "Typically promotions only last 7 days so check if the code was issued a long time ago.   That might be the reason it doesn’t work."
        },
        {
          "source_path": "Purchase Dispute/subflows/Promo Code Invalid/actions/1/subtext/0",
          "source_text": "If the promo code is more than 7 days, then the correct subflow is 'out of date', otherwise, the correct subflow is 'invalid'"
        }
      ]
    },
