          "source_text": "Gold members: > Gold members get unlimited returns"
        }
      ]
    },
    {
      "id": "return_silver",
      "applies_to": [
        "return_size",
        "return_color",
        "return_stain"
      ],
      "when": {
        "all": [
          {
            "member_level": "silver"
