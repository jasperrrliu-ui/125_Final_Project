        "return_method_options": [
          "By Mail",
          "In Store",
          "Drop off Center"
        ]
      },
      "origin": "abcd_guidelines",
      "evidence": [
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/3/text",
          "source_text": "Communication"
        },
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/3/subtext/0",
          "source_text": "If the customer can return, tell them the good news and go to the next step"
        },
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/4/text",
          "source_text": "Since the customer will print out a shipping label for the return, you need their full address.  You can give this explanation if the customer asks why you need the address."
        },
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/4/subtext/0",
          "source_text": "Street Number and Street Name"
        },
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/4/subtext/1",
          "source_text": "City, State, Zip Code"
        },
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/4/subtext/2",
          "source_text": "Fill this as one line into [Enter Details]"
        },
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/5/text",
          "source_text": "Ask the customer how they would like to process their return:"
        },
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/5/subtext/0",
          "source_text": "Options include: 'By Mail', 'In Store', or 'Drop off Center'"
        },
        {
          "source_path": "Product Defect/subflows/Return Due to Size/actions/5/subtext/1",
          "source_text": "Fill in the form with one of these three values and submit to [Update Order]"
        }
      ]
